ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# cheap/fast model used only for the incident-report extraction stage (backend/reports.py)
HAIKU_MODEL=claude-haiku-4-5-20251001
# optional — leave blank to disable Slack notifications entirely
SLACK_WEBHOOK_URL=

# slack-bot/ — second first-class interface (Socket Mode slash command /overwatch).
# Optional: only started with `docker compose --profile slack up`. Get these from
# an app you create at api.slack.com/apps (Socket Mode enabled): SLACK_BOT_TOKEN
# is under OAuth & Permissions (xoxb-...), SLACK_APP_TOKEN is an App-Level Token
# under Basic Information with the connections:write scope (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# proactive watcher (backend/watcher.py) — all optional, these are the defaults
WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=30
WATCH_CONTAINERS=target-app
LEAK_THRESHOLD_BYTES=50000000
WATCH_COOLDOWN_SECONDS=300
